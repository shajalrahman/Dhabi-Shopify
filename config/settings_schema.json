  },
  {
    "name": "Logo & Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (light / white version)"
      },
      {
        "type": "image_picker",
        "id": "logo_dark",
        "label": "Logo (dark version for mobile menu)"
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo height (px)",
        "min": 20,
        "max": 80,
        "step": 2,
        "default": 42,
        "unit": "px"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
