  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer_enabled",
        "label": "Enable cart drawer",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_empty_message",
        "label": "Empty cart message",
        "default": "Your cart is empty"
      },
      {
        "type": "text",
        "id": "cart_empty_submessage",
        "label": "Empty cart sub-message",
        "default": "Add some Eco Woltt products to get started!"
      }
    ]
  },
  {
    "name": "Currency",
    "settings": [
      {
        "type": "text",
        "id": "currency_code",
        "label": "Currency display code",
        "default": "AED",
        "info": "Displayed next to prices. Actual currency is set in Shopify settings."
      }
    ]
  }
