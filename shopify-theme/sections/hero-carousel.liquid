<section class="hero container">
  <div class="hero__carousel" id="heroCarousel" data-autoplay="{% if section.settings.autoplay %}true{% else %}false{% endif %}" data-interval="{{ section.settings.autoplay_interval | times: 1000 }}">
    
    <div class="hero__track" id="heroTrack">
      {%- for block in section.blocks -%}
        <div class="hero__slide" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">
          {%- endif -%}
            
          {%- if block.settings.image != blank -%}
            <img 
              src="{{ block.settings.image | image_url: width: 1920 }}" 
              alt="{{ block.settings.image.alt | escape }}" 
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {%- else -%}
            <div style="width: 100%; aspect-ratio: 1920/338; background: var(--gray-200); display: flex; align-items: center; justify-content: center; font-weight: 700;">1920 x 338</div>
          {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <button class="hero__arrow hero__arrow--prev" id="heroPrev" aria-label="{{ 'accessibility.previous_slide' | t }}">
        {% render 'icon-svg', icon: 'chevron-left' %}
      </button>
      <button class="hero__arrow hero__arrow--next" id="heroNext" aria-label="{{ 'accessibility.next_slide' | t }}">
        {% render 'icon-svg', icon: 'chevron-right' %}
      </button>

      <div class="hero__dots" id="heroDots">
        {%- for block in section.blocks -%}
          <button class="hero__dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="{{ 'accessibility.slide_number' | t: number: forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Hero Carousel",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Change slides every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "1920 x 338px recommended for desktop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
