<div class="container section-padded" style="padding: 48px 0; max-width: 900px; margin: 0 auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
    <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--navy);">{{ 'customer.account' | t }}</h1>
    <a href="{{ routes.account_logout_url }}" style="font-size: 0.9rem; font-weight: 600; color: var(--danger);">{{ 'customer.logout' | t }}</a>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 300px; gap: 40px;">
    <div>
      <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 20px;">{{ 'customer.orders' | t }}</h2>
      {%- if customer.orders.size > 0 -%}
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
          <thead>
            <tr style="border-bottom: 2px solid var(--gray-200);">
              <th style="padding: 12px 0;">Order</th>
              <th>Date</th>
              <th>Status</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr style="border-bottom: 1px solid var(--gray-100);">
                <td style="padding: 16px 0;"><a href="{{ order.customer_url }}" style="font-weight: 700; color: var(--navy);">{{ order.name }}</a></td>
                <td>{{ order.created_at | date: format: 'date' }}</td>
                <td>
                  <span style="display:inline-block; padding: 4px 10px; border-radius: 4px; font-size: 0.8rem; font-weight: 600; background: var(--gray-100);">{{ order.fulfillment_status_label }}</span>
                </td>
                <td style="font-weight: 600;">{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- else -%}
        <p style="color: var(--gray-500);">You haven't placed any orders yet.</p>
      {%- endif -%}
    </div>

    <div>
      <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 20px;">Account Details</h2>
      <div style="background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: 24px;">
        <p style="font-weight: 700; margin-bottom: 8px;">{{ customer.name }}</p>
        <p style="color: var(--gray-600); margin-bottom: 16px;">{{ customer.email }}</p>
        {%- if customer.default_address -%}
          <div style="font-size: 0.9rem; color: var(--gray-700); line-height: 1.6;">
            {{ customer.default_address | format_address }}
          </div>
        {%- endif -%}
        <a href="{{ routes.account_addresses_url }}" style="display: inline-block; margin-top: 16px; font-size: 0.85rem; font-weight: 600; color: var(--navy);">View Addresses ({{ customer.addresses_count }})</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Account"
}
{% endschema %}
