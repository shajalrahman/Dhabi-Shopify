<div class="container section-padded" style="margin-top: 24px; margin-bottom: 48px;">
  
  <header class="collection-header">
    {%- if collection.image -%}
      <img src="{{ collection.image | image_url: width: 1200 }}" alt="{{ collection.title | escape }}" width="{{ collection.image.width }}" height="{{ collection.image.height }}" class="collection-header__banner" loading="lazy">
    {%- endif -%}
    <h1 class="collection-header__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-header__desc">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {% paginate collection.products by 24 %}
    
    <div class="collection-toolbar">
      <div class="collection-toolbar__count">{{ 'collections.products_count' | t: count: collection.products_count }}</div>
      <div class="collection-toolbar__sort">
        <label for="SortBy" class="sr-only">{{ 'collections.sort_by' | t }}</label>
        <select name="sort_by" id="SortBy" onchange="location = this.value;">
          {%- for option in collection.sort_options -%}
            <option value="?sort_by={{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
              {{ option.name }}
            </option>
          {%- endfor -%}
        </select>
      </div>
    </div>

    {%- if collection.products_count == 0 -%}
      <div style="text-align: center; padding: 60px 20px; color: var(--gray-500);">
        {{ 'collections.no_products' | t }}
      </div>
    {%- else -%}
      <div class="products-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <div class="pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="pagination__item" aria-label="{{ 'pagination.previous' | t }}">
            {% render 'icon-svg', icon: 'chevron-left' %}
          </a>
        {%- endif -%}

        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="pagination__item" aria-label="{{ 'pagination.page' | t: number: part.title }}">{{ part.title }}</a>
          {%- else -%}
            {%- if part.title == paginate.current_page -%}
              <span class="pagination__item is-active" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="pagination__item" style="border:none;">{{ part.title }}</span>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="pagination__item" aria-label="{{ 'pagination.next' | t }}">
            {% render 'icon-svg', icon: 'chevron-right' %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  {% endpaginate %}
</div>

{% schema %}
{
  "name": "Collection pages",
  "settings": []
}
{% endschema %}
