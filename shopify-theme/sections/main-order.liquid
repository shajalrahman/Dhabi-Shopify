<div class="container section-padded" style="padding: 48px 0; max-width: 900px; margin: 0 auto;">
  <div style="margin-bottom: 32px;">
    <a href="{{ routes.account_url }}" style="font-size: 0.85rem; font-weight: 600; color: var(--gray-500); display: inline-flex; align-items: center; gap: 4px; margin-bottom: 12px;">{% render 'icon-svg', icon: 'chevron-left' %} Back to Account</a>
    <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--navy);">Order {{ order.name }}</h1>
    <p style="color: var(--gray-500); margin-top: 4px;">Placed on {{ order.created_at | date: format: 'date_at_time' }}</p>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 320px; gap: 40px;">
    <div>
      <table style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
          <tr style="border-bottom: 2px solid var(--gray-200);">
            <th style="padding: 12px 0;">Product</th>
            <th style="text-align: center;">Price</th>
            <th style="text-align: center;">Quantity</th>
            <th style="text-align: right;">Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr style="border-bottom: 1px solid var(--gray-100);">
              <td style="padding: 16px 0; display: flex; gap: 12px; align-items: center;">
                {%- if line_item.image -%}
                  <img src="{{ line_item.image | image_url: width: 80 }}" alt="{{ line_item.title | escape }}" width="{{ line_item.image.width }}" height="{{ line_item.image.height }}" style="width: 60px; height: 60px; object-fit: contain; border: 1px solid var(--gray-200); border-radius: 6px;" loading="lazy">
                {%- endif -%}
                <div>
                  <a href="{{ line_item.product.url }}" style="font-weight: 600; color: var(--navy);">{{ line_item.title }}</a>
                  {%- if line_item.variant.title != 'Default Title' -%}
                    <div style="font-size: 0.8rem; color: var(--gray-500);">{{ line_item.variant.title }}</div>
                  {%- endif -%}
                </div>
              </td>
              <td style="text-align: center;">{{ line_item.price | money }}</td>
              <td style="text-align: center;">{{ line_item.quantity }}</td>
              <td style="text-align: right; font-weight: 700;">{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3" style="padding: 16px 0; text-align: right; color: var(--gray-600);">Subtotal</td>
            <td style="text-align: right; font-weight: 600;">{{ order.line_items_subtotal_price | money }}</td>
          </tr>
          <tr>
            <td colspan="3" style="padding: 8px 0; text-align: right; color: var(--gray-600);">Shipping ({{ order.shipping_method.title }})</td>
            <td style="text-align: right; font-weight: 600;">{{ order.shipping_price | money }}</td>
          </tr>
          <tr>
            <td colspan="3" style="padding: 16px 0; text-align: right; font-size: 1.1rem; font-weight: 800; color: var(--navy);">Total</td>
            <td style="text-align: right; font-size: 1.1rem; font-weight: 800; color: var(--navy);">{{ order.total_price | money }}</td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div>
      <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 16px;">Billing Address</h2>
      <div style="background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: 20px; font-size: 0.9rem; line-height: 1.6; margin-bottom: 24px;">
        <p style="font-weight: 700;">Payment Status: {{ order.financial_status_label }}</p>
        <div style="margin-top: 12px;">{{ order.billing_address | format_address }}</div>
      </div>
      
      <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 16px;">Shipping Address</h2>
      <div style="background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: 20px; font-size: 0.9rem; line-height: 1.6;">
        <p style="font-weight: 700;">Fulfillment Status: {{ order.fulfillment_status_label }}</p>
        <div style="margin-top: 12px;">{{ order.shipping_address | format_address }}</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Order"
}
{% endschema %}
