<div class="container section-padded" style="padding-top: 48px; padding-bottom: 64px; max-width: 800px; margin: 0 auto;">
  <h1 style="font-size: 2rem; font-weight: 800; color: var(--navy); margin-bottom: 32px; text-align: center;">{{ page.title }}</h1>
  <div style="line-height: 1.8; color: var(--gray-800); font-size: 1rem;">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page"
}
{% endschema %}
