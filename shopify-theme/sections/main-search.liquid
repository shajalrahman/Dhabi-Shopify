<div class="container section-padded" style="margin-bottom: 48px;">
  
  <header class="search-header">
    <h1 class="search-header__title">{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" class="search-header__form" role="search">
      <input type="hidden" name="type" value="product">
      <input class="search-header__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
    </form>
  </header>

  {%- if search.performed -%}
    <div style="font-size: 0.9rem; color: var(--gray-600); margin-bottom: 24px;">
      {{ 'search.results_count' | t: count: search.results_count, query: search.terms }}
    </div>

    {%- if search.results_count == 0 -%}
      <div style="text-align: center; padding: 60px 20px; color: var(--gray-500);">
        {{ 'search.no_results' | t: query: search.terms }}
      </div>
    {%- else -%}
      {% paginate search.results by 24 %}
        <div class="products-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="pagination__item" aria-label="{{ 'pagination.previous' | t }}">
                {% render 'icon-svg', icon: 'chevron-left' %}
              </a>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="pagination__item" aria-label="{{ 'pagination.page' | t: number: part.title }}">{{ part.title }}</a>
              {%- else -%}
                {%- if part.title == paginate.current_page -%}
                  <span class="pagination__item is-active" aria-current="page">{{ part.title }}</span>
                {%- else -%}
                  <span class="pagination__item" style="border:none;">{{ part.title }}</span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="pagination__item" aria-label="{{ 'pagination.next' | t }}">
                {% render 'icon-svg', icon: 'chevron-right' %}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {% endpaginate %}
    {%- endif -%}
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Search Results"
}
{% endschema %}
