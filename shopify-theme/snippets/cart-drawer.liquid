{% comment %}
  Renders the cart drawer overlay and sidebar.
{% endcomment %}

<div class="cart-overlay" id="cartOverlay"></div>
<div class="cart-drawer" id="cartDrawer">
  <div class="cart-drawer__header">
    <div class="cart-drawer__title">{{ 'cart.title' | t }}</div>
    <button class="cart-drawer__close" id="cartClose" aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon-svg', icon: 'close' %}
    </button>
  </div>
  
  <div class="cart-drawer__body" id="cartBody">
    {%- if cart.item_count == 0 -%}
      <div class="cart-drawer__empty" id="cartEmptyState">
        {% render 'icon-svg', icon: 'cart' %}
        <h3>{{ settings.cart_empty_message }}</h3>
        <p>{{ settings.cart_empty_submessage }}</p>
      </div>
      <div id="cartItemsList"></div>
    {%- else -%}
      <div class="cart-drawer__empty" id="cartEmptyState" style="display: none;">
        {% render 'icon-svg', icon: 'cart' %}
        <h3>{{ settings.cart_empty_message }}</h3>
        <p>{{ settings.cart_empty_submessage }}</p>
      </div>
      <div id="cartItemsList">
        {%- for item in cart.items -%}
          <div class="cart-item" data-key="{{ item.key }}">
            <div class="cart-item__img">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title | escape }}" loading="lazy" width="{{ item.image.width }}" height="{{ item.image.height }}">
              {%- else -%}
                {% render 'icon-svg', icon: 'cart' %}
              {%- endif -%}
            </div>
            <div class="cart-item__info">
              <div class="cart-item__title">{{ item.product.title }}</div>
              {%- unless item.product.has_only_default_variant -%}
                <div style="font-size: 0.75rem; color: var(--gray-500); margin-bottom: 4px;">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="cart-item__price">{{ item.final_line_price | money }}</div>
              
              <div class="cart-item__qty">
                <button class="cart-item__qty-btn cart-qty-minus" data-key="{{ item.key }}" aria-label="{{ 'accessibility.decrease_quantity' | t }}">-</button>
                <span class="cart-item__qty-val">{{ item.quantity }}</span>
                <button class="cart-item__qty-btn cart-qty-plus" data-key="{{ item.key }}" aria-label="{{ 'accessibility.increase_quantity' | t }}">+</button>
              </div>
              <button class="cart-item__remove cart-remove-item" data-key="{{ item.key }}">{{ 'cart.remove' | t }}</button>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  
  <div class="cart-drawer__footer" id="cartFooter" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
    <div class="cart-drawer__total">
      <span>{{ 'cart.total' | t }}</span>
      <span id="cartTotal">{{ cart.total_price | money }}</span>
    </div>
    <a href="{{ routes.cart_url }}" class="cart-drawer__checkout" id="cartCheckoutBtn">
      {{ 'cart.checkout' | t }}
    </a>
  </div>
</div>
