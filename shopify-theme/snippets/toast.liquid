{% comment %}
  Renders a toast notification for cart/wishlist actions.
{% endcomment %}

<div class="toast" id="toastMessage">
  <svg class="toast__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
  <span id="toastText">Item added successfully</span>
</div>
